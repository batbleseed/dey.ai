{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and workspace preferences",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "theme": { "type": "string" },
        "defaultModel": { "type": "string" },
        "systemInstruction": { "type": "string" },
        "enableWebSearch": { "type": "boolean" },
        "messageBoxWidth": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid"]
    },
    "Chat": {
      "title": "Chat",
      "description": "Chat session document belonging to a user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" },
        "isPinned": { "type": "boolean" },
        "model": { "type": "string" }
      },
      "required": ["id", "userId", "title", "createdAt", "updatedAt"]
    },
    "Message": {
      "title": "Message",
      "description": "Message in a chat conversation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "chatId": { "type": "string" },
        "userId": { "type": "string" },
        "role": { "type": "string" },
        "content": { "type": "string" },
        "timestamp": { "type": "number" },
        "model": { "type": "string" }
      },
      "required": ["id", "chatId", "userId", "role", "content", "timestamp"]
    },
    "CanvasDocument": {
      "title": "CanvasDocument",
      "description": "Canvas scratchpad document belonging to a user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "language": { "type": "string" },
        "content": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "userId", "title", "language", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profile and workspace settings"
    },
    "/users/{userId}/chats/{chatId}": {
      "schema": { "$ref": "#/entities/Chat" },
      "description": "Chat sessions for a user"
    },
    "/users/{userId}/chats/{chatId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/Message" },
      "description": "Messages belonging to a chat"
    },
    "/users/{userId}/canvas/{docId}": {
      "schema": { "$ref": "#/entities/CanvasDocument" },
      "description": "User saved code and scratchpad canvas documents"
    }
  }
}
